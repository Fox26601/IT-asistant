# Copy to .env and fill once. Never commit .env.
# CSV keeps [ІМʼЯ]/[EMAIL]/… — script fills them from OUTREACH_*.
# Sales-agent secrets live in sales-agent/.env.example → sales-agent/.env

# --- Your profile (used in every letter) ---
OUTREACH_NAME=your_name
OUTREACH_EMAIL=your_email@example.com
OUTREACH_GITHUB=https://github.com/your_github
OUTREACH_DEMO1=https://github.com/your_github/demo-agent-1
OUTREACH_DEMO2=https://github.com/your_github/demo-agent-2

# --- SMTP (only for npm run outreach:send) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@example.com
FROM_NAME=your_name

# Optional: override CSV path
# OUTREACH_CSV=outreach/employers.csv
