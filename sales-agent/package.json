{
  "name": "sales-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Sales dialogue agent: Telegram + web form → Google Calendar + owner notify",
  "type": "module",
  "scripts": {
    "dev": "tsx watch bot/index.ts",
    "start": "tsx bot/index.ts",
    "auth:google": "tsx bot/auth-google.ts",
    "mail:send": "tsx scripts/send-corp-mail.ts",
    "typecheck": "tsc --noEmit"
