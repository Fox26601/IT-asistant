  "engines": {
    "node": ">=22"
  },
  "vercel": {
    "installCommand": "npm ci"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.14.0",
    "@neondatabase/serverless": "^1.2.2",
    "googleapis": "^148.0.0",
    "grammy": "^1.35.0",
    "hono": "^4.7.0",
    "nodemailer": "^10.6.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
