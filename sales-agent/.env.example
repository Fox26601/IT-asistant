# Copy to sales-agent/.env and fill in. Never commit .env (or any real secrets).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
# Long random string. Used as:
#   1) path segment /telegram/webhook/<secret>
#   2) Telegram setWebhook secret_token (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- HTTP (web form webhooks) ---
PORT=3847
# Shared with site SALES_AGENT_WEBHOOK_SECRET. Header x-webhook-secret only (no ?secret=).
WEBHOOK_SECRET=
# Local long-poll: http://localhost:3847
# Production / Vercel webhook: https://<project>.vercel.app  (HTTPS, no trailing slash)
PUBLIC_BASE_URL=http://localhost:3847

# --- Symbolic Pleasures site API (read-only sales-agent endpoints) ---
SITE_BASE_URL=https://symbolicpleasures.com
# Same value as site SALES_AGENT_WEBHOOK_SECRET; falls back to WEBHOOK_SECRET if empty
SITE_WEBHOOK_SECRET=

# --- Google Calendar (npm run auth:google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3847/oauth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
TZ=Europe/Kyiv

# Optional: mock calendar/notify when secrets missing (dev)
ALLOW_MOCK_INTEGRATIONS=true

# --- Postgres (Vercel Postgres / Neon) — required for sessions + escalations ---
# DATABASE_URL=postgresql://…  (set automatically when Neon is connected on Vercel)
# POSTGRES_URL=                 # alias accepted

# --- Corp outbound mail (prefer Resend on Vercel / serverless) ---
# Resend HTTP — recommended. Free tier: https://resend.com
# RESEND_API_KEY=
# MAIL_FROM=kiniks@symbolicpleasures.com
# (MAIL_FROM falls back to SMTP_FROM. Bare address only — do NOT set SMTP_FROM_NAME.)

# SMTP fallback (often blocked on serverless egress; works on local / some VPS)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=kiniks@symbolicpleasures.com
# SMTP_PASSWORD=
# SMTP_FROM=kiniks@symbolicpleasures.com
# SMTP_TLS_MODE=auto
# Do not set SMTP_FROM_NAME — From is MAIL_FROM / SMTP_FROM only (no display name).

# --- Vercel Cron (protects /cron/*) ---
# CRON_SECRET=
