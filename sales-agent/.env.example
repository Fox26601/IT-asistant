# Copy to sales-agent/.env and fill in. Never commit .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
# Random string used in webhook path /telegram/webhook/<secret> (Render)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- HTTP (web form webhook) ---
PORT=3847
WEBHOOK_SECRET=your_webhook_secret
# Local: http://localhost:3847 → long polling
# Render: https://<sales-agent>.onrender.com → Telegram webhook
PUBLIC_BASE_URL=http://localhost:3847

# --- Symbolic Pleasures site API (read-only sales-agent endpoints) ---
SITE_BASE_URL=https://symbolicpleasures.com
# Same value as site SALES_AGENT_WEBHOOK_SECRET; falls back to WEBHOOK_SECRET if empty
SITE_WEBHOOK_SECRET=

# --- Google Calendar (npm run auth:google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3847/oauth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
TZ=Europe/Kyiv

# Optional: mock calendar/notify when secrets missing (dev)
ALLOW_MOCK_INTEGRATIONS=true
